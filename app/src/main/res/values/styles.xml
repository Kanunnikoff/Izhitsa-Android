<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="actionBarStyle">@style/MyActionBar</item>
    </style>

    <style name="MyActionBar" parent="@style/Widget.AppCompat.ActionBar">
        <item name="android:background">@color/colorPrimary</item>
        <item name="background">@color/colorPrimary</item>
        <item name="android:titleTextStyle">@style/MyTheme.ActionBar.TitleTextStyle</item>
        <item name="titleTextStyle">@style/MyTheme.ActionBar.TitleTextStyle</item>
        <item name="subtitleTextColor">@android:color/white</item>
    </style>

    <style name="MyTheme.ActionBar.TitleTextStyle" parent="@android:style/TextAppearance">
        <item name="android:textColor">@android:color/white</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:textSize">25sp</item>
        <item name="android:color">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
    </style>

    <style name="KeyboardEmojiPickerLight" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:colorBackground">#EEEDF4</item>
        <item name="colorSurface">#EEEDF4</item>
        <item name="colorPrimary">#475D92</item>
        <item name="colorControlNormal">#45464F</item>
        <item name="android:textColorPrimary">#1B1B1F</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="KeyboardEmojiPickerDark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">#1E1F25</item>
        <item name="colorSurface">#1E1F25</item>
        <item name="colorPrimary">#AFC6FF</item>
        <item name="colorControlNormal">#C4C6D0</item>
        <item name="android:textColorPrimary">#E2E2E9</item>
        <item name="android:fontFamily">sans</item>
    </style>

</resources>
